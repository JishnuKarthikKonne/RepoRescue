# Add credentials only locally. Never commit .env.
# Switch Agent Bridge Settings (Switch Core 0.31.0+)
SWITCH_SERVER_URL=http://localhost:65008
SWITCH_API_KEY=
SWITCH_AGENT_ID=reporescue
SWITCH_ROOM_ID=

# GitHub Settings (Secure Draft PR creation)
# Fine-Grained PAT required permissions: Pull Requests (read/write), Contents (read/write)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
GITHUB_API_URL=https://api.github.com
GITHUB_REPO_ALLOWLIST=
GITHUB_DRY_RUN=false
